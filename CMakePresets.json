{
  "version": 2,
  "cmakeMinimumRequired": {"major": 3, "minor": 21},
  "configurePresets": [
    {
      "name": "portable-engine",
      "displayName": "CoreMach engine and tests (no Qt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/portable-engine",
      "cacheVariables": {"BUILD_TESTING": true, "CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "portable-qt",
      "displayName": "CoreMach with BluMach Qt6 launcher",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/portable-qt",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_BUILD_TYPE": "Release",
        "BLUMACH_BUILD_PORTABLE_QT": true
      }
    }
  ]
}
