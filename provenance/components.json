{
  "schema": "blumach-component-provenance-v1",
  "coverage_roots": [
    "engine",
    "runtime",
    "components",
    "systems",
    "platforms",
    "apps"
  ],
  "components": [
    {
      "id": "portable-engine-core",
      "destination": ["engine/**"],
      "method": "new",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["BluMach contributors"],
      "local_changes": "Initial deterministic engine, CPU contract and scheduler"
    },
    {
      "id": "generic-address-bus",
      "destination": ["components/buses/**"],
      "method": "new",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["BluMach contributors"],
      "local_changes": "Initial host-independent address-space bus"
    },
    {
      "id": "generic-linear-memory",
      "destination": ["components/memory/**"],
      "method": "new",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["BluMach contributors"],
      "local_changes": "Host-allocated RAM and ROM regions with endian-neutral bus transactions"
    },
    {
      "id": "nec-v30-bring-up-interpreter",
      "destination": ["components/cpu/808x/**"],
      "origin_repository": "https://github.com/BluMach/BluMach",
      "origin_commit": "08893f4fd0392ea6e95e9abbe108f0d8f1fbbe1c",
      "origin_paths": ["src/cpu/808x.c", "src/cpu/808x_common.c"],
      "method": "derived-rewrite",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["Andrew Jenner", "Miran Grca", "BluMach contributors"],
      "local_changes": "Replaced global CPU state and legacy memory coupling with explicit state and bus transactions; only the reset bring-up instruction subset is present"
    },
    {
      "id": "portable-runtime-session",
      "destination": ["runtime/**"],
      "method": "new",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["BluMach contributors"],
      "local_changes": "Initial opaque session lifecycle and typed machine factory"
    },
    {
      "id": "null-host-platform",
      "destination": ["platforms/null/**"],
      "method": "new",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["BluMach contributors"],
      "local_changes": "Deterministic host adapter for tests and headless use"
    },
    {
      "id": "headless-frontend",
      "destination": ["apps/headless/**"],
      "method": "new",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["BluMach contributors"],
      "local_changes": "Minimal frontend proving that Qt is optional"
    },
    {
      "id": "olivetti-pcs86-portable-system",
      "destination": ["systems/olivetti-pcs86/**"],
      "origin_repository": "https://github.com/BluMach/BluMach",
      "origin_commit": "08893f4fd0392ea6e95e9abbe108f0d8f1fbbe1c",
      "origin_paths": ["src/machine/m_xt_olivetti_pcs86.c", "doc/machines/olivetti-pcs86.md"],
      "method": "derived-rewrite",
      "license": "GPL-2.0-or-later",
      "copyright_holders": ["rtzor", "BluMach contributors"],
      "local_changes": "Isolated the documented V30, 640 KiB RAM and interleaved system ROM map behind a typed machine factory"
    }
  ],
  "external_dependencies": []
}
